        <!-- SIMPLE FORM -->

        <f:SimpleForm
            id="_IDGenSimpleForm"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanL="2"
            labelSpanM="2"
            emptySpanL="6"
            emptySpanM="6"
        >
            <f:content>
                <!-- SELECT -->

                <Label
                    id="_IDGenLabel"
                    text="Please select from the selectBox"
                />

                <Select
                    id="oSEName"
                    items="{oModel>/EmployeeSet}"
                >
                    <items>
                        <c:Item
                            id="_IDGenItem"
                            text="{oModel>Name}"
                            key="{oModel>Name}"
                        />
                    </items>
                </Select>

                <!-- COMBOBOX -->

                <Label
                    id="_IDGenLabel1"
                    text="Please select from the comboBox"
                />

                <ComboBox
                    id="oCBName"
                    items="{oModel>/EmployeeSet}"
                >
                    <items>
                        <c:Item
                            id="_IDGenItem1"
                            text="{oModel>Name}"
                            key="{oModel>Name}"
                        />
                    </items>
                </ComboBox>

                <!-- MULTICOMBOBOX -->

                <Label
                    id="_IDGenLabel2"
                    text="Please select from the MulticomboBox"
                />

                <MultiComboBox
                    id="oMCBName"
                    items="{oModel>/EmployeeSet}"
                    showSelectAll="true"
                >
                    <items>
                        <c:Item
                            id="_IDGenItem2"
                            text="{oModel>Name}"
                            key="{oModel>Name}"
                        />
                    </items>
                </MultiComboBox>

                <!-- RADIO BUTTON GROUP -->

                <Label
                    id="_IDGenLabel3"
                    text="Please select from the RadioButtonGroup"
                />

                <RadioButtonGroup
                    id="oRBGName"
                    buttons="{oModel>/EmployeeSet}"
                    columns="3"
                    selectedIndex="-1"
                >
                    <buttons>
                        <RadioButton
                            id="_IDGenRadioButton"
                            text="{oModel>Name}"
                        />
                    </buttons>
                </RadioButtonGroup>
            </f:content>
        </f:SimpleForm>

