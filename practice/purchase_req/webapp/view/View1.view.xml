<mvc:View
    controllerName="purchasereq.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.suite.ui.commons"
>

<Page title="Create Purchase Requisition">

    <content>
        <IconTabBar expandable="false">

            <items>

                <!-- ================= HEADER ================= -->
                <IconTabFilter text="Header" icon="sap-icon://document">

                    <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanL="3"
                        labelSpanM="3"
                        columnsL="2"
                        columnsM="2"
                    >

                        <Title text="Basic Information"/>

                        <Label text="PR Type"/>
                        <Select selectedKey="{/header/prType}" items="{/valueHelp/prTypes}">
                            <core:Item key="{key}" text="{text}"/>
                        </Select>

                        <Label text="Company Code"/>
                        <Input value="{/header/companyCode}"/>

                        <Label text="Purchasing Org"/>
                        <Input value="{/header/purchOrg}"/>

                        <Label text="Purchasing Group"/>
                        <Input value="{/header/purchGroup}"/>

                        <Title text="Organizational Data"/>

                        <Label text="Plant"/>
                        <Select selectedKey="{/header/plant}" items="{/valueHelp/plants}">
                            <core:Item key="{key}" text="{text}"/>
                        </Select>

                        <Label text="Storage Location"/>
                        <Input value="{/header/storageLoc}"/>

                        <Label text="Source Determination"/>
                        <Switch state="{/header/sourceDet}"/>

                        <Title text="Notes"/>

                        <Label text="Header Note"/>
                        <TextArea value="{/header/note}" rows="3"/>

                    </form:SimpleForm>

                </IconTabFilter>

                <!-- ================= ITEM OVERVIEW ================= -->
                <IconTabFilter text="Item Overview" icon="sap-icon://list">

                    <Table
                        id="itemTable"
                        items="{/items/results}"
                        mode="SingleSelectMaster"
                        growing="true"
                        growingThreshold="5"
                    >

                        <!-- Toolbar -->
                        <headerToolbar>
                            <Toolbar>
                                <Title text="Item Overview"/>
                                <ToolbarSpacer/>
                                <Button text="Add" icon="sap-icon://add" press="onAddItem"/>
                                <Button text="Delete" icon="sap-icon://delete" press="onRemoveItem"/>
                            </Toolbar>
                        </headerToolbar>

                        <!-- Columns -->
                        <columns>
                            <Column><Text text="Item"/></Column>
                            <Column><Text text="Material"/></Column>
                            <Column><Text text="Description"/></Column>
                            <Column><Text text="Qty"/></Column>
                            <Column><Text text="Price"/></Column>
                            <Column><Text text="Plant"/></Column>
                            <Column><Text text="Delivery Date"/></Column>
                        </columns>

                        <!-- Rows -->
                        <items>
                            <ColumnListItem>

                                <cells>
                                    <Text text="{itemNo}"/>

                                    <Input value="{material}"/>

                                    <Input value="{description}"/>

                                    <Input value="{quantity}" type="Number"/>

                                    <Input value="{price}" type="Number"/>

                                    <Select
                                        selectedKey="{plant}"
                                        items="{/valueHelp/plants}"
                                    >
                                        <core:Item key="{key}" text="{text}"/>
                                    </Select>

                                    <DatePicker value="{deliveryDate}"/>
                                </cells>

                            </ColumnListItem>
                        </items>

                    </Table>

                    <HBox justifyContent="End" class="sapUiMediumMarginTop">
                        <Button text="Submit PR" type="Emphasized" press="onSubmit"/>
                    </HBox>

                </IconTabFilter>

                <!-- ================= APPROVAL ================= -->
                <IconTabFilter text="Approval" icon="sap-icon://approvals">

                    <VBox class="sapUiMediumMargin">

                        <!-- Status -->
                        <ObjectStatus
                            text="{/approval/status}"
                            state="{= ${/approval/status} === 'Approved' ? 'Success' :
                                     ${/approval/status} === 'Rejected' ? 'Error' : 'Warning' }"
                        />

                        <!-- Timeline -->
                        <tnt:Timeline items="{/approval/history}">

                            <tnt:TimelineItem
                                title="{approver}"
                                text="{comment}"
                                dateTime="{date}"
                            />

                        </tnt:Timeline>

                        <!-- Actions -->
                        <HBox justifyContent="End" class="sapUiMediumMarginTop">
                            <Button text="Approve" type="Accept" press="onApprove"/>
                            <Button text="Reject" type="Reject" press="onReject" class="sapUiSmallMarginBegin"/>
                        </HBox>

                    </VBox>

                </IconTabFilter>

            </items>

        </IconTabBar>
    </content>

</Page>
</mvc:View>