{
  "_version": "1.84.0",
  "sap.app": {
    "id": "purchasereq",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json"
  },

  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": false,

    "dependencies": {
      "minUI5Version": "1.147.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.suite.ui.commons": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "purchasereq.i18n.i18n"
        }
      },

      "": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/data.json",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "purchasereq.view",
        "async": true,
        "viewPath": "purchasereq.view"
      },

      "routes": [
        {
          "name": "RouteView1",
          "pattern": "",
          "target": ["TargetView1"]
        }
      ],

      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        }
      }
    },

    "rootView": {
      "viewName": "purchasereq.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}