<mvc:View
    controllerName="znorthwind.controller.znorthwind"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <List
            backgroundDesign="Transparent"
            headerText="{i18n>categoriesTitle}"
            items="{/Categories}"
            growing="true"
            growingThreshold="2"
        >
            <items>
                <StandardListItem
                    title="{CategoryName}"
                    description="{Description}"
                    type="Navigation"
                    press="onClick"
                />
            </items>
        </List>
    </Page>
</mvc:View>
