<mvc:View
    controllerName="project1.controller.practice1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="page"
        title="{i18n>title}"
        class="sapUiContentPadding"
    >
        <content>

            <!-- 🔹 Toolbar Section -->
            <Toolbar id="_IDGenToolbar1" class="sapUiSmallMarginBottom sapUiSmallPadding">
                <Button id="_IDGenButton"
                    text="click me"
                    icon="sap-icon://accessibility"
                    press="click_me"
                    type="Transparent"
                />
                <ToolbarSpacer id="_IDGenToolbarSpacer" />

                <Button id="_IDGenButton1"
                    icon="sap-icon://edit"
                    ariaLabelledBy="editButtonLabel"
                    class="sapUiTinyMarginEnd"
                />

                <ToolbarSeparator id="_IDGenToolbarSeparator" />

                <Button id="_IDGenButton2"
                    icon="sap-icon://add"
                    activeIcon="sap-icon://accept"
                    text="activeIcon"
                    class="sapUiTinyMarginBegin"
                />
            </Toolbar>

            <!-- 🔹 VBox Section -->
            <VBox id="_IDGenVBox" class="sapUiMediumMargin sapUiSmallPadding">
                <Button id="_IDGenButton3"
                    text="Button 1"
                    width="200px"
                    class="sapUiSmallMarginBottom"
                />
                <Button id="_IDGenButton4"
                    text="Button 2"
                    class="sapUiSmallMarginBottom"
                />
                <Button id="_IDGenButton5" text="Button 3" />
            </VBox>

            <!-- 🔹 HBox Section -->
            <HBox id="_IDGenHBox" class="sapUiMediumMargin sapUiSmallPadding">
                <Button id="_IDGenButton6" text="Save" class="sapUiTinyMarginEnd" />
                <Button id="_IDGenButton7" text="Edit" class="sapUiTinyMarginEnd" />
                <Button id="_IDGenButton8" text="Delete" />
            </HBox>

            <!-- 🔹 Flex Grow Section -->
            <HBox id="_IDGenHBox1" class="sapUiMediumMargin sapUiSmallPadding">
                <Button id="_IDGenButton9" text="A" class="sapUiTinyMarginEnd">
                    <layoutData>
                        <FlexItemData id="_IDGenFlexItemData" growFactor="2" />
                    </layoutData>
                </Button>

                <Button id="_IDGenButton10" text="B">
                    <layoutData>
                        <FlexItemData id="_IDGenFlexItemData1" growFactor="1" />
                    </layoutData>
                </Button>
            </HBox>

            <!-- 🔹 Single Buttons Section -->
            <VBox id="_IDGenVBox1" class="sapUiMediumMargin sapUiSmallPadding">

                <Button id="_IDGenButton11"
                    text="Menu Button"
                    class="sapUiSmallMarginBottom"
                >
                    <customData>
                        <core:CustomData
                            key="aria-haspopup"
                            value="menu"
                            writeToDom="true"
                        />
                    </customData>
                </Button>

                <Button id="_IDGenButton12"
                    text="width property button"
                    width="200px"
                    class="sapUiSmallMarginBottom"
                />

                <Button id="_IDGenButton13"
                    text="Save"
                    type="Accept"
                    class="sapUiTinyMarginEnd"
                />
                <Button id="_IDGenButton14"
                    text="Delete"
                    type="Reject"
                    class="sapUiTinyMarginBottom"
                />

                <Button id="_IDGenButton15"
                    text="Save"
                    icon="sap-icon://save"
                    iconFirst="false"
                    badgeStyle="Attention"
                    class="sapUiSmallMarginBottom"
                />

                <Button id="_IDGenButton16"
                    text="Save"
                    icon="sap-icon://save"
                    enabled="false"
                    class="sapUiSmallMarginBottom"
                />

                <Button id="_IDGenButton17"
                    icon="sap-icon://accept"
                    class="sapUiSmallMarginBottom"
                />

            </VBox>

            <!-- 🔹 Accessibility Section -->
            <VBox id="_IDGenVBox2" class="sapUiMediumMargin sapUiSmallPadding">

                <Button id="_IDGenButton18"
                    text="Submit23"
                    press="onPress"
                    ariaDescribedBy="defaultButtonDescription genericButtonDescription"
                    class="sapUiSmallMarginBottom"
                />

                <Button id="_IDGenButton19"
                    text="submit234"
                    icon="sap-icon://edit"
                    press="onPress"
                    ariaLabelledBy="editButtonLabel"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    id="genericButtonDescription"
                    text="This button shows a message when pressed."
                    class="sapUiSmallMarginTop"
                />

                <core:InvisibleText
                    id="defaultButtonDescription"
                    text="This is the submit button used to send data."
                />

                <core:InvisibleText
                    id="editButtonLabel"
                    text="Edit Button"
                />

            </VBox>

        </content>
    </Page>
</mvc:View>